# G04 local dependencies. Run ./scripts/dev.ps1 init to create ignored .env
# with independent random passwords. Never commit the generated file.
# Shared by Compose and Spring dev profile (working directory: backend).
# Use plain KEY=value, no quotes, export, escapes, ${...}, or inline comments.
# Generated hex passwords avoid dotenv / Java properties parsing differences.
MYSQL_IMAGE=mysql:8.4.13
REDIS_IMAGE=redis:7.2.16-alpine
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=investlens
MYSQL_USER=investlens
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# G02 probes: default market candidate is Sina, no market key required.
# Mainland direct access is required; all probe HTTP proxies are disabled.
# Keep real values in ignored .env or environment.
# No shell expansion; do not put secrets on the command line.
# Optional alternate source; not the default deployment dependency.
TWELVE_DATA_API_KEY=
PROBE_STOCK_SYMBOL=AAPL
PROBE_GOLD_ETF_SYMBOL=GLD
PROBE_SILVER_ETF_SYMBOL=SLV

# Existing DEEPSEEK_API_KEY can be used without copying it into this file.
# Override URL/model for another approved compatible provider as needed.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
