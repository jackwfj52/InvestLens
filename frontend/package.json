{
  "name": "investlens-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.18.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "test:proxy": "node scripts/check-proxy.ts"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
